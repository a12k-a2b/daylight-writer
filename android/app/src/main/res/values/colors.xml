<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==========================================================================
         Daylight Sol:OS Official Neutral Grayscale Tokens
         Target: Daylight Computer (DC1) 10.5" LivePaper 8-bit Reflective LCD
         Profile: 256 discrete gray levels, 60Hz-120Hz Native Refresh
         ========================================================================== -->

    <!-- Base Grayscale Scale (0 to 1000) -->
    <color name="sol_os_0">#FFFFFF</color>              <!-- 255: Base paper ground / canvas background -->
    <color name="sol_os_50">#F7F7F7</color>             <!-- 247: Drawer surface, card panels, floating overlays -->
    <color name="sol_os_100">#DCD5C9</color>            <!-- 215: Hairline borders (1px), dividers, subtle outlines -->
    <color name="sol_os_100_alpha">#14000000</color>    <!-- rgba(0,0,0,0.08): Translucent hairline overlay -->
    <color name="sol_os_150">#F5F5F5</color>            <!-- 245: Recessed input fields, search background -->
    <color name="sol_os_200">#CCCCCC</color>            <!-- 204: Disabled buttons, inactive indicators, leader lines -->
    <color name="sol_os_300">#858585</color>            <!-- 133: Low-emphasis text, dimmed focus text, clock -->
    <color name="sol_os_400">#535353</color>            <!-- 83:  Secondary text ink, snippet previews -->
    <color name="sol_os_800">#343434</color>            <!-- 52:  Hover / pressed control states, active pills -->
    <color name="sol_os_900">#1A1A1A</color>            <!-- 26:  Primary text ink, document headings -->
    <color name="sol_os_1000">#000000</color>           <!-- 0:   Maximum black ink, active focused sentence -->

    <!-- Calibrated Brand Grays (Perceptually Uniform on Reflective Panel) -->
    <color name="sol_os_brand_yellow">#CECECE</color>   <!-- Calibrated brand yellow -> gray (206) -->
    <color name="sol_os_brand_amber">#9D9D9E</color>    <!-- Calibrated brand amber -> gray (157) -->
    <color name="sol_os_brand_orange">#6C6C6D</color>   <!-- Calibrated brand orange -> gray (108) -->

    <!-- Semantic UI Aliases -->
    <color name="canvas_background">@color/sol_os_0</color>
    <color name="surface_panel">@color/sol_os_50</color>
    <color name="border_hairline">@color/sol_os_100</color>
    <color name="text_primary">@color/sol_os_900</color>
    <color name="text_secondary">@color/sol_os_400</color>
    <color name="text_tertiary">@color/sol_os_300</color>
    <color name="text_disabled">@color/sol_os_200</color>
</resources>
