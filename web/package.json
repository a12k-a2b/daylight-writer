{
  "name": "daylight-writer",
  "version": "0.1.0",
  "private": true,
  "description": "Distraction-free landscape typewriter Progressive Web App for the Daylight Computer (DC1) LivePaper display",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 'tests/**/*.test.ts'",
    "test:e2e": "node --experimental-strip-types --test 'tests/e2e/**/*.test.ts'",
    "test:unit": "node --experimental-strip-types --test 'tests/unit/**/*.test.ts'",
    "test:tier1": "node --experimental-strip-types --test 'tests/e2e/tier1-features/*.test.ts'",
    "test:tier2": "node --experimental-strip-types --test 'tests/e2e/tier2-boundaries/*.test.ts'",
    "test:tier3": "node --experimental-strip-types --test 'tests/e2e/tier3-combinations/*.test.ts'",
    "test:tier4": "node --experimental-strip-types --test 'tests/e2e/tier4-scenarios/*.test.ts'",
    "test:contrast": "node --experimental-strip-types --test 'tests/e2e/contrast-audit.test.ts'",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "daylight-computer",
    "dc1",
    "livepaper",
    "typewriter",
    "sol-os",
    "pwa",
    "powersync",
    "sqlite"
  ],
  "author": "Daylight Writer Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@journeyapps/wa-sqlite": "^2.0.4",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-collaboration": "^2.27.3",
    "@tiptap/extension-collaboration-cursor": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "wa-sqlite": "^1.0.0",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "happy-dom": "^17.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.8"
  }
}
